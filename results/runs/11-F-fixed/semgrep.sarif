                },
                "region": {
                  "endColumn": 6,
                  "endLine": 190,
                  "snippet": {
                    "text": "    public function update(Request $request, Bill $bill)\n    {\n        $request->validate([\n            'status' => 'required|in:Pending,Paid,Partial',\n        ]);\n\n        // If status is being changed to Paid, update payment fields\n        if ($request->status === 'Paid' && $bill->status !== 'Paid') {\n            $bill->paid_amount = $bill->total_amount;\n            $bill->due_amount = 0;\n            $bill->status = 'Paid';\n            $bill->save();\n        } else {\n            $bill->update(['status' => $request->status]);\n        }\n\n        return response()->json([\n            'success' => true,\n            'message' => 'Bill updated successfully'\n        ]);\n    }"
                  },
                  "startColumn": 5,
                  "startLine": 170
                }
              }
            }
          ],
          "message": {
            "text": "Controller action receives a model but performs no authorization check."
          },
          "properties": {},
          "ruleId": "security.laravel-missing-authorization"
        },
